    ]
  },
  "cases": [
    {
      "id": "writing-rubric-green",
      "argv": ["node", "runner.mjs"],
      "timeout_s": 10,
      "expected_behavior": "The candidate emits rubric scores >= 0.8 on all three dimensions, zero forbidden claims and a matched audience.",
      "provenance": {
        "source": "examples/domain-heldout/writing/workspace/runner.mjs",
        "independent_of_training": true,
        "reviewed_by": "domain-heldout-reviewer"
      },
      "checks": [
        {"id": "exit", "kind": "exit_code", "equals": 0},
        {"id": "writing-gate", "kind": "script", "path": "grade.mjs", "args": ["outputs/result.json"], "pass_exit_codes": [0]}
      ],
      "safety_checks": []
    }
  ]
}
