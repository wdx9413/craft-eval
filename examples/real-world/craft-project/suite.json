{
  "schema": "craft-eval.eval.v1",
  "suite_id": "craft-project",
  "subject_kind": "software",
  "partition": "development",
  "sanitized": true,
  "claim": {
    "statement": "craft 仓库的类型检查、架构/接口/文档一致性审计与 CLI smoke 在其仓库内通过",
    "scope": "单机离线；不含真实模型评测与线上环境",
    "limitations": ["不覆盖全部 365 个单测（耗时过长）", "文档审计只覆盖链接与必需文档"]
  },
  "metrics": {
    "primary": {
      "id": "task_pass",
      "kind": "binary_pass_rate",
      "direction": "higher_is_better",
      "minimum_sample": 9
    }
  },
  "cases": [
    {
      "id": "typecheck",
      "category": "static",
      "risk": "high",
      "language": "typescript",
      "argv": ["node", "node_modules/typescript/bin/tsc", "--noEmit"],
      "in_place": true,
      "timeout_s": 600,
      "expected_behavior": "The full Craft source type graph has no TypeScript errors.",
      "provenance": { "source": "craft/package.json:scripts.typecheck" },
      "checks": [{ "id": "exit", "kind": "exit_code", "equals": 0 }]
    },
    {
      "id": "layering",
      "category": "architecture",
      "risk": "high",
      "language": "typescript",
      "argv": ["node", "--experimental-strip-types", "scripts/ci/audit-layering.ts"],
      "in_place": true,
      "timeout_s": 300,
      "expected_behavior": "The dependency layering audit finds no violations and no undocumented import exemptions.",
      "provenance": { "source": "craft/scripts/ci/audit-layering.ts" },
      "checks": [
        { "id": "exit", "kind": "exit_code", "equals": 0 },
        { "id": "layer-audit-ran", "kind": "stdout_contains", "value": "layer audit:" }
      ]
    },
    {
      "id": "surfaces",
      "category": "architecture",
      "risk": "high",
      "language": "typescript",
      "argv": ["node", "--experimental-strip-types", "scripts/ci/audit-surfaces.ts"],
      "in_place": true,
      "timeout_s": 300,
      "expected_behavior": "The MCP surface audit confirms tool ownership and declared cross-domain exceptions.",
      "provenance": { "source": "craft/scripts/ci/audit-surfaces.ts" },
      "checks": [
        { "id": "exit", "kind": "exit_code", "equals": 0 },
        { "id": "surface-audit-ran", "kind": "stdout_contains", "value": "surface audit:" }
      ]
    },
    {
      "id": "audit-docs",
      "category": "documentation",
      "risk": "medium",
      "language": "markdown",
      "argv": ["node", "--experimental-strip-types", "scripts/ci/check-doc-links.ts"],
      "in_place": true,
      "timeout_s": 300,
      "expected_behavior": "The required product documentation exists and all indexed internal links resolve.",
      "provenance": { "source": "craft/scripts/ci/check-doc-links.ts" },
      "checks": [
        { "id": "exit", "kind": "exit_code", "equals": 0 },
        { "id": "document-audit-ran", "kind": "stdout_contains", "value": "doc check:" }
      ]
    },
    {
      "id": "consistency",
      "category": "documentation",
      "risk": "medium",
      "language": "markdown",
      "argv": ["node", "--experimental-strip-types", "scripts/ci/check-consistency-falsifiable.ts"],
      "in_place": true,
      "timeout_s": 300,
      "expected_behavior": "The baseline remains consistent and all nine declared mutations are detected.",
      "provenance": { "source": "craft/scripts/ci/check-consistency-falsifiable.ts" },
      "checks": [
        { "id": "exit", "kind": "exit_code", "equals": 0 },
        { "id": "mutation-audit-ran", "kind": "stdout_contains", "value": "falsifiable on 9/9 mutations" }
      ]
    },
    {
      "id": "smoke",
      "category": "runtime",
      "risk": "medium",
      "language": "typescript",
      "argv": ["node", "dist/core/cli.js", "--help"],
      "in_place": true,
      "timeout_s": 180,
      "expected_behavior": "The packaged Craft CLI starts and reports its usage contract.",
      "provenance": { "source": "craft/package.json:scripts.test:smoke" },
      "checks": [
        { "id": "exit", "kind": "exit_code", "equals": 0 },
        { "id": "usage-is-reported", "kind": "stdout_contains", "value": "Usage:" }
      ]
    },
    {
      "id": "docs",
      "category": "documentation",
      "risk": "low",
      "language": "markdown",
      "in_place": true,
      "timeout_s": 120,
      "expected_behavior": "Required repository docs and their relative links are present and resolve.",
      "provenance": { "source": "craft-eval docs_links check over Craft documentation" },
      "checks": [{
        "id": "links",
        "kind": "docs_links",
        "required": ["README.md", "CONTEXT.md", "DESIGN.md", "GLOSSARY.md", "UX-CONTRACT.md"],
        "dirs": ["docs"]
      }]
    },
    {
      "id": "context-receipt-audit-coverage",
      "category": "static",
      "risk": "high",
      "language": "typescript",
      "argv": [
        "node", "--test", "--test-isolation=none", "--experimental-test-coverage", "--test-coverage-lines=100", "--test-coverage-functions=100", "--test-coverage-branches=100",
        "--test-coverage-include=core/workbench-context-audit.ts", "--test-coverage-include=core/interfaces/workbench-context-audit-route.ts",
        "tests/workbench-context-audit.test.ts", "tests/workbench-context-audit-route.test.ts"
      ],
      "in_place": true,
      "timeout_s": 180,
      "expected_behavior": "The Context audit persistence and Workbench route matcher meet strict line, function and branch coverage.",
      "provenance": { "source": "craft/package.json:scripts.test:coverage:workbench-context-audit" },
      "checks": [
        { "id": "coverage-exits-zero", "kind": "exit_code", "equals": 0 },
        { "id": "coverage-reaches-100", "kind": "stdout_contains", "value": "100.00" }
      ]
    },
    {
      "id": "workbench-evaluation-coverage",
      "category": "static",
      "risk": "high",
      "language": "typescript",
      "argv": [
        "node_modules/.bin/c8", "--reporter=text", "--include=core/workbench-evaluations.ts", "--check-coverage", "--lines", "100", "--branches", "100", "--functions", "100",
        "node", "--test", "--test-isolation=none", "--test-concurrency=1",
        "tests/workbench-evaluation-concurrency.test.ts", "tests/bundled-knowledge-task-effects.test.ts", "tests/workbench-evaluations.test.ts", "tests/workbench-context-audit.test.ts", "tests/knowledge-task-effects.test.ts", "tests/evaluation-process.test.ts"
      ],
      "in_place": true,
      "timeout_s": 240,
      "expected_behavior": "Controlled Workbench evaluation and Context audit delegation meet strict line, function and branch coverage.",
      "provenance": { "source": "craft/tests/coverage-gates.json:workbench-controlled-evaluations" },
      "checks": [
        { "id": "coverage-exits-zero", "kind": "exit_code", "equals": 0 },
        { "id": "coverage-reaches-100", "kind": "stdout_contains", "value": "100" }
      ]
    }
  ]
}
