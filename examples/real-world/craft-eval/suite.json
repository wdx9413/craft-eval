{
  "schema": "craft-eval.eval.v1",
  "suite_id": "craft-eval-capabilities",
  "subject_kind": "software",
  "partition": "development",
  "sanitized": true,
  "claim": {
    "statement": "The named craft-eval regression tests and package build pass on the declared local runtime.",
    "scope": "Local deterministic regression checks for craft-eval only.",
    "limitations": [
      "Does not establish Craft or Workbench product quality or real-world task benefit."
    ]
  },
  "metrics": {
    "primary": {
      "id": "case_pass_rate",
      "kind": "binary_pass_rate",
      "direction": "higher_is_better",
      "minimum_sample": 23
    },
    "guardrails": [
      {
        "id": "build_pass",
        "metric": "build_pass",
        "comparator": "gte",
        "threshold": 1
      }
    ]
  },
  "cases": [
