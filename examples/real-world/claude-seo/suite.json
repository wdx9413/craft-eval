        {"id": "pass-rate", "kind": "script", "path": "pass_rate.py", "interpreter": ["py", "-3"], "pass_exit_codes": [0]},
        {"id": "no-internal-errors", "kind": "json_equals", "path": "outputs/pytest-result.json", "key": "errors", "equals": 0}
      ]
    }
  ]
}
