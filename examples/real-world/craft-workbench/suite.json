{
  "schema": "craft-eval.eval.v1",
  "suite_id": "craft-workbench-local-quality-gates",
  "subject_kind": "software",
  "partition": "development",
  "sanitized": true,
  "claim": {
    "statement": "The Workbench repository's automated tests and installed Runtime protocol check pass on the pinned local environment.",
    "scope": "Local deterministic checks in the craft-workbench checkout.",
    "limitations": [
      "Does not establish desktop packaging, accessibility, visual usability, real Host behavior or user task benefit.",
      "The Runtime check validates package resolution and protocol compatibility, not end-to-end task execution."
    ]
  },
  "metrics": {
    "primary": {
      "id": "quality_gate_pass_rate",
      "kind": "binary_pass_rate",
      "direction": "higher_is_better",
      "minimum_sample": 3
    },
    "guardrails": [
      {
        "id": "runtime_protocol_compatible",
        "metric": "runtime_protocol_compatible",
        "comparator": "gte",
        "threshold": 1
      }
    ]
  },
  "cases": [
    {
      "id": "runtime-sidecar-contract",
      "category": "release",
      "risk": "critical",
      "language": "javascript",
      "in_place": true,
      "argv": ["node", "desktop/scripts/prepare-sidecar.mjs"],
      "timeout_s": 120,
      "expected_behavior": "The installed immutable Craft package can be staged as the Workbench desktop sidecar using its declared npm artifact contract.",
      "provenance": { "source": "craft-workbench/desktop/scripts/prepare-sidecar.mjs" },
      "checks": [{ "id": "sidecar-preflight-exits-zero", "kind": "exit_code", "equals": 0 }]
    },
    {
      "id": "workbench-tests",
      "category": "regression",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node",
        "--experimental-strip-types",
        "--test",
        "tests/agent-workspace.test.ts",
        "tests/asset-focus.test.ts",
        "tests/asset-revisions-page.test.ts",
        "tests/composer-controls.test.ts",
        "tests/context-workflow-pages.test.ts",
        "tests/context-audit-panel.test.ts",
        "tests/hook-diagnostics.test.ts",
        "tests/evaluation-panel.test.ts",
        "tests/message-dock.test.ts",
        "tests/mod-pages.test.ts",
        "tests/mode-pages.test.ts",
        "tests/mode-shell.test.ts",
        "tests/native-tools-panel.test.ts",
        "tests/project-shell.test.ts",
        "tests/queue-recovery.test.ts",
        "tests/rail-nav.test.ts",
        "tests/recall-audit.test.ts",
        "tests/tauri-desktop-contract.test.ts",
        "tests/ui-primitives.test.ts",
        "tests/visual-layer.test.ts",
        "tests/workbench-assets.test.ts",
        "tests/workbench-latest-request.test.ts",
        "tests/workbench-model-setup.test.ts",
        "tests/workbench-project-page.test.ts",
        "tests/workbench-resource-pages.test.ts",
        "tests/workbench-runtime-client.test.ts"
      ],
      "timeout_s": 300,
      "expected_behavior": "All Workbench automated tests complete with zero failures; the separately gated localhost integration case runs only when loopback binding is available.",
      "provenance": {
        "source": "craft-workbench/package.json:scripts.test"
      },
      "checks": [
        {
          "id": "test-process-exits-zero",
          "kind": "exit_code",
          "equals": 0
        },
        {
          "id": "tests-ran",
          "kind": "stdout_not_contains",
          "value": "tests 0"
        }
      ]
    },
    {
      "id": "runtime-package-unit",
      "category": "runtime-integration",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node",
        "--experimental-strip-types",
        "--test",
        "--test-name-pattern",
        "^(installed runtime resolves without a sibling checkout and prepares the public sidecar|the installed runtime declares fixed mandatory peers for its Claude SDK|the installed public runtime inventories legacy project data without changing it|the installed runtime imports pinned legacy assets as candidates and restores data before registration)$",
        "tests/runtime-package.test.ts"
      ],
      "timeout_s": 90,
      "expected_behavior": "Installed Runtime package resolution, protocol declarations and offline migration behavior pass without network access.",
      "provenance": { "source": "craft-workbench/tests/runtime-package.test.ts" },
      "checks": [
        { "id": "runtime-package-unit-exits-zero", "kind": "exit_code", "equals": 0 },
        { "id": "unit-tests-ran", "kind": "stdout_not_contains", "value": "tests 0" }
      ]
    },
    {
      "id": "runtime-http-loopback",
      "category": "runtime-integration",
      "risk": "high",
      "language": "javascript",
      "requires": { "network_loopback": true },
      "in_place": true,
      "argv": [
        "node",
        "--experimental-strip-types",
        "--test",
        "--test-name-pattern",
        "^the installed CLI serves recovery assets, reconciles an input and executes its pinned evaluator over HTTP$",
        "tests/runtime-package.test.ts"
      ],
      "timeout_s": 60,
      "expected_behavior": "The installed CLI binds localhost and completes its HTTP recovery and evaluation integration path.",
      "provenance": { "source": "craft-workbench/tests/runtime-package.test.ts" },
      "checks": [
        { "id": "integration-exits-zero", "kind": "exit_code", "equals": 0 },
        { "id": "integration-ran", "kind": "stdout_contains", "value": "the installed CLI serves recovery assets" }
      ]
    },
    {
      "id": "runtime-package-compatible",
      "category": "runtime-integration",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node",
        "scripts/run-runtime.mjs",
        "check"
      ],
      "timeout_s": 90,
      "expected_behavior": "Workbench resolves its installed Craft package and confirms the supported runtime protocol.",
      "provenance": {
        "source": "craft-workbench/scripts/run-runtime.mjs; craft-workbench/scripts/runtime-package.mjs"
      },
      "checks": [
        {
          "id": "runtime-check-exits-zero",
          "kind": "exit_code",
          "equals": 0
        },
        {
          "id": "runtime-version-reported",
          "kind": "stdout_contains",
          "value": "Craft runtime"
        }
      ]
    },
    {
      "id": "context-audit-panel-coverage",
      "category": "static",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node", "--experimental-strip-types", "--test", "--test-isolation=none", "--experimental-test-coverage", "--test-coverage-lines=100", "--test-coverage-functions=100", "--test-coverage-branches=100",
        "--test-coverage-include=workbench/context-audit-panel.js", "tests/context-audit-panel.test.ts"
      ],
      "timeout_s": 180,
      "expected_behavior": "The Context audit interface passes strict line, function and branch coverage.",
      "provenance": { "source": "craft-workbench/package.json:scripts.test:coverage:context-audit" },
      "checks": [
        { "id": "coverage-exits-zero", "kind": "exit_code", "equals": 0 },
        { "id": "coverage-reaches-100", "kind": "stdout_contains", "value": "100.00" }
      ]
    },
    {
      "id": "hook-diagnostics-panel-coverage",
      "category": "static",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node", "--experimental-strip-types", "--test", "--test-isolation=none", "--experimental-test-coverage", "--test-coverage-lines=100", "--test-coverage-functions=100", "--test-coverage-branches=100",
        "--test-coverage-include=workbench/hook-diagnostics.js", "tests/hook-diagnostics.test.ts"
      ],
      "timeout_s": 120,
      "expected_behavior": "The on-demand Hook diagnostic view distinguishes failure, skipped, unmatched and partial evidence with strict coverage.",
      "provenance": { "source": "craft-workbench/package.json:scripts.test:coverage:hook-diagnostics" },
      "checks": [
        { "id": "coverage-exits-zero", "kind": "exit_code", "equals": 0 },
        { "id": "coverage-reaches-100", "kind": "stdout_contains", "value": "100.00" }
      ]
    }
  ]
}
