{
  "schema": "craft-eval.eval.v1",
  "suite_id": "craft-workbench-three-modes",
  "subject_kind": "software",
  "partition": "development",
  "sanitized": true,
  "claim": {
    "statement": "Craft Workbench can ship the three surfaces (领航员 / 控制台 / 工作台) as separate desktop apps whose pages never depend on each other, while every mode still reads the same Runtime truth.",
    "scope": "Deterministic regression checks over the Craft Workbench checkout: mode module boundaries, per-mode behaviour, single-surface pinning, page inventory, settings and design contract.",
    "limitations": [
      "These cases run the repository test suite, not an installed desktop app, so installer behaviour and real user sessions are not covered.",
      "No model is involved: the checks prove the UI contract, not task quality or model accuracy."
    ]
  },
  "metrics": {
    "primary": {
      "id": "case_pass_rate",
      "kind": "binary_pass_rate",
      "direction": "higher_is_better",
      "minimum_sample": 6
    }
  },
  "cases": [
    {
      "id": "mode-pages-are-independent-modules",
      "category": "architecture",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node",
        "--experimental-strip-types",
        "--test",
        "--test-isolation=none",
        "tests/mode-shell.test.ts"
      ],
      "timeout_s": 120,
      "expected_behavior": "Each mode page is its own module, no mode module imports a sibling, and the app fetches the owning mode page lazily so a single-surface build never downloads the other two projections.",
      "provenance": {
        "source": "craft-workbench/tests/mode-shell.test.ts",
        "source_digest": "sha256:89e0ac64296d5febd7b7a70ac77ba03b60bb418e2dd7e098dc752703a1d9e859"
      },
      "checks": [
        {
          "id": "tests-pass",
          "kind": "exit_code",
          "equals": 0
        },
        {
          "id": "no-test-failures",
          "kind": "stdout_contains",
          "value": "ℹ fail 0"
        },
        {
          "id": "module-boundary-asserted",
          "kind": "stdout_contains",
          "value": "each mode page is an independent module"
        }
      ]
    },
    {
      "id": "pilot-control-workshop-behaviour",
      "category": "behaviour",
      "risk": "high",
      "language": "javascript",
      "in_place": true,
      "argv": [
        "node",
        "--experimental-strip-types",
        "--test",
        "--test-isolation=none",
        "tests/mode-pages.test.ts",
        "tests/three-mode-consistency.test.ts",
        "tests/three-mode-journey.test.ts"
      ],
      "timeout_s": 180,
      "expected_behavior": "领航员 keeps its minimal surface for non-technical users, 控制台 shows the shared task board, and 工作台 keeps the plugin and Mod configuration surface; all three read the same Runtime truth.",
      "provenance": {
        "source": "craft-workbench/tests/mode-pages.test.ts",
        "source_digest": "sha256:b6b88f06e12d672bded0be18bf8ef030eecb6208fab7d4880b2d0277476dc739"
      },
      "checks": [
        {
          "id": "tests-pass",
