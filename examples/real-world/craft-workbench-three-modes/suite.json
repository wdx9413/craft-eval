          "id": "no-test-failures",
          "kind": "stdout_contains",
          "value": "ℹ fail 0"
        },
        {
          "id": "pilot-surface-asserted",
          "kind": "stdout_contains",
          "value": "viewPilot is a minimal superagent surface"
        }
      ]
    },
    {
