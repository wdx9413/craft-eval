{
  "schema": "craft-eval.eval.v1",
  "suite_id": "judge-gold-set",
  "subject_kind": "software",
  "partition": "held_out",
  "sanitized": true,
  "description": "Gold set for calibrating model-graded judges. Each case pins an exact expected output so a judge command can be scored for accuracy and self-consistency.",
  "cases": [
    {
      "id": "arithmetic-pass",
      "argv": ["node", "-e", "console.log(17 * 23)"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "arithmetic-fail-wrong-answer",
      "argv": ["node", "-e", "console.log(390)"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "reverse-pass",
      "argv": ["node", "-e", "console.log('tfarc')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "reverse-fail-wrong-answer",
      "argv": ["node", "-e", "console.log('craft')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "json-pass",
      "argv": ["node", "-e", "console.log('{\"ok\":true}')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "json-fail-malformed",
      "argv": ["node", "-e", "console.log('{ok:true}')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "sort-pass",
      "argv": ["node", "-e", "console.log('1 3 5 9')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "sort-fail-unsorted",
      "argv": ["node", "-e", "console.log('5 3 9 1')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "boundary-empty-string",
      "argv": ["node", "-e", "console.log('')"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    },
    {
      "id": "boundary-large-number",
      "argv": ["node", "-e", "console.log(9007199254740991)"],
      "timeout_s": 10,
      "checks": [{"id": "exit", "kind": "exit_code", "equals": 0}]
    }
  ]
}
