{
  "name": "craft-eval",
  "version": "0.7.2",
  "description": "Evidence-backed evaluation for software, agents and skills",
  "type": "module",
  "bin": {
    "craft-eval": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./suite": {
      "types": "./dist/src/suite.d.ts",
      "import": "./dist/src/suite.js"
    },
    "./compare-run-reports": {
      "types": "./dist/src/compare-run-reports.d.ts",
      "import": "./dist/src/compare-run-reports.js"
    },
    "./paired-value-runs": {
      "types": "./dist/src/paired-value-runs.d.ts",
      "import": "./dist/src/paired-value-runs.js"
    },
    "./model": {
      "types": "./dist/src/model.d.ts",
      "import": "./dist/src/model.js"
    },
    "./run": {
      "types": "./dist/src/run.d.ts",
      "import": "./dist/src/run.js"
    },
    "./recurrence": {
      "types": "./dist/src/recurrence.d.ts",
      "import": "./dist/src/recurrence.js"
    },
    "./compare": {
      "types": "./dist/src/compare.d.ts",
      "import": "./dist/src/compare.js"
    },
    "./abstraction": {
      "types": "./dist/src/abstraction.d.ts",
      "import": "./dist/src/abstraction.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "docs/command-supervision.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test dist/tests/*.test.js && npm run test:build-suite && npm run test:coverage:context-audit && npm run test:coverage:web-research",
    "test:build-suite": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=examples/real-world/craft-eval/build-suite.mjs tests/build-suite.test.ts",
    "test:coverage:web-research": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=dist/tests/craft-web-research-fixtures.test.js dist/tests/craft-web-research-fixtures.test.js",
    "test:coverage:context-audit": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=dist/src/context-audit.js dist/tests/context-audit.test.js",
    "prepack": "npm run clean && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "craft-common-base": "0.20.4",
    "craft-common-store-local": "0.20.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft-eval.git"
  },
  "homepage": "https://github.com/wdx9413/craft-eval#readme",
  "bugs": {
    "url": "https://github.com/wdx9413/craft-eval/issues"
  }
}
